# ──────────────────────────────────────────────────────────────────────────────
# Kingdom Quest Web — Environment Variable Template
# ──────────────────────────────────────────────────────────────────────────────
# This file IS committed to source control. It serves as documentation of
# what environment variables are required and where to get them.
#
# To use: copy this file to .env.local (git-ignored) and fill in real values.
#   cp .env.local.example .env.local
#
# OWASP ASVS §2.10 — Service credentials must not be hard-coded in source.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Source: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Firebase (Client-side / Public) ──────────────────────────────────────────
# Source: Firebase Console → Project settings → Your apps → Web app
# These values are public by design — see lib/firebase/client.ts for full explanation.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Source: Firebase Console → Project settings → Cloud Messaging → Web Push certificates
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-vapid-key-here
